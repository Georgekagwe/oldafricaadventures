# These are the environment variables the /api serverless functions need in
# production. Add them in Vercel: Project → Settings → Environment Variables
# (never commit a real ".env" file with real secrets).
#
# For local testing with `vercel dev`, copy this file to ".env" and fill in
# real values — but the everyday local workflow described in README.md
# (Live Server + backend/server.js) uses backend/.env instead.

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business-gmail@gmail.com
SMTP_PASS=your-16-character-app-password

# Where enquiry emails should land (can be the same as SMTP_USER).
BUSINESS_EMAIL=oldafricaadventures@gmail.com

# --- WhatsApp (optional, advanced) ------------------------------------------
# Leave blank to skip — the site still works fine with the free wa.me button.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
BUSINESS_WHATSAPP_NUMBER=
